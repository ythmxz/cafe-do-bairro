generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  RECEBIDA
  PREPARO
  ENTREGUE

  @@map("order_status")
}

model Order {
  id           Int         @id @default(autoincrement())
  customer     String
  phone        String
  product      String
  deliveryDate DateTime    @map("delivery_date") @db.Date
  status       OrderStatus @default(RECEBIDA)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([deliveryDate])
  @@map("orders")
}
